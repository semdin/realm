msgstr "Yeniden davet etmeden önce biraz bekle."

msgid "Wait a moment before challenging again."
msgstr "Yeniden meydan okumadan önce biraz bekle."

msgid "That player is not accepting challenges."
msgstr "Bu oyuncu meydan okuma kabul etmiyor."

msgid "Block Player"
msgstr "Engelle"

msgid "Unblock Player"
msgstr "Engeli Kaldır"

msgid "Report Player"
msgstr "Oyuncuyu Şikâyet Et"

msgid "Report %s"
msgstr "%s adlı oyuncuyu şikâyet et"

msgid "Harassment"
msgstr "Taciz"

msgid "Hate speech"
