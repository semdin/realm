msgstr "Şikâyeti Gönder"

msgid "Your report was sent. Thank you."
msgstr "Şikâyetin gönderildi. Teşekkürler."

msgid "%s is blocked. You will not see their messages or invitations."
msgstr "%s engellendi. Mesajlarını ve davetlerini görmeyeceksin."

msgid "%s is no longer blocked."
msgstr "%s artık engelli değil."

msgid "Please wait a little before sending another report."
msgstr "Yeni bir şikâyet göndermeden önce biraz bekle."

msgid "You have sent too many reports today."
msgstr "Bugün çok fazla şikâyet gönderdin."

msgid "You already reported this player recently."
msgstr "Bu oyuncuyu kısa süre önce şikâyet ettin."

msgid "You cannot do that to yourself."
msgstr "Bunu kendine yapamazsın."

msgid "Your block list is full."
msgstr "Engel listen dolu."

msgid "No player with that name was found."
msgstr "Bu isimde bir oyuncu bulunamadı."

msgid "That is not available right now."
msgstr "Bu şu an kullanılamıyor."

msgid "You can speak again."
msgstr "Yeniden konuşabilirsin."

msgid "You have been muted."
msgstr "Susturuldun."

msgid "You have been muted until %s."
msgstr "%s tarihine kadar susturuldun."

msgid "Reason: %s"
msgstr "Sebep: %s"

msgid "Until: %s"
msgstr "Bitiş: %s"

msgid "This ban does not expire."
msgstr "Bu yasağın süresi dolmaz."

