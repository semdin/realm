; The realm client. Game state lives in the realm_client extension (Rust);
; scripts here only draw it and read the player's controls.
config_version=5

[application]
config/name="Thousand Realms"
; Its own user folder (%APPDATA%/ThousandRealms, ~/.local/share/ThousandRealms,
; ~/Library/Application Support/ThousandRealms): the old game kept its
; settings under the project name ("Thousand Realms") with other keys.
config/use_custom_user_dir=true
config/custom_user_dir_name="ThousandRealms"
; Dev and check runs (the editor binary: `godot --path game`) keep their own
; folder (ThousandRealmsDev), so they never rewrite a player's settings,
; quest marks or caches on the same machine; exported games are unaffected.
config/custom_user_dir_name.editor="ThousandRealmsDev"
; The window's first frame: the realm's logo on dark, not Godot's.
boot_splash/bg_color=Color(0.027, 0.035, 0.055, 1)
boot_splash/image="res://assets/branding/boot_splash.png"
boot_splash/stretch_mode=1
boot_splash/use_filter=true
run/main_scene="res://main.tscn"
; Every printed line reaches the log file at once (release builds buffer it
; otherwise): a game killed while stuck (Alt+F4, Task Manager) kept only its
; first three lines (2026-11-16). The game prints little per frame.
run/flush_stdout_on_print=true
; The window, taskbar and dock icon (the launcher's emblem); exports put it
; into the .exe and the macOS bundle too (export_presets.cfg).
config/icon="res://assets/branding/thousand_realms_icon.png"
config/features=PackedStringArray("4.8", "Mobile")

[autoload]

RenderCompat="*res://scripts/autoload/render_compat.gd"
I18n="*res://scripts/autoload/i18n.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
ExitMark="*res://scripts/autoload/exit_mark.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/screen_space_aa=1
textures/vram_compression/import_etc2_astc=true
; Interface pictures are drawn smaller than their source (a 256 px icon in a
; 24-64 px slot): plain linear filtering reads a few texels per pixel and the
; icons sparkle. Linear with mipmaps reads the level nearest the drawn size;
; textures without mipmaps (glyphs, map sheets drawn larger) are unaffected.
textures/canvas_textures/default_texture_filter=2
; Godot saves the pipeline cache on a worker thread each time it grows by this
; much, while other threads still create pipelines into it; Intel's Vulkan
; driver (igvk64.dll 32.0.101.8991) crashed in vkGetPipelineCacheData doing so
; during a map's shader warm-up (2026-11-22, Karaağ entry, 0xC0000005). The
; cache now grows in memory and is written once at quit, when nothing compiles.
rendering_device/pipeline_cache/save_chunk_size_mb=100000.0

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/PretendardStdVariable.ttf"
theme/custom_font_size=15
theme/custom_theme="res://assets/ui/realm.tres"
timers/tooltip_delay_sec=0.08

[internationalization]

locale/translations=PackedStringArray("res://locale/tr.po", "res://locale/account.tr.po", "res://locale/player.tr.po")
