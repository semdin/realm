; The realm client. Game state lives in the realm_client extension (Rust);
; scripts here only draw it and read the player's controls.
config_version=5

[application]
config/name="Thousand Realms"
; Its own user folder (%APPDATA%/ThousandRealms, ~/.local/share/ThousandRealms,
; ~/Library/Application Support/ThousandRealms): the old game kept its
; settings under the project name ("Thousand Realms") with other keys.
config/use_custom_user_dir=true
config/custom_user_dir_name="ThousandRealms"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

I18n="*res://scripts/autoload/i18n.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/screen_space_aa=1
textures/vram_compression/import_etc2_astc=true

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/Literata-Variable.ttf"
theme/custom_font_size=15
theme/custom_theme="res://assets/ui/realm.tres"
timers/tooltip_delay_sec=0.08

[internationalization]

locale/translations=PackedStringArray("res://locale/tr.po")
