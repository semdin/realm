; Both editor/debug runs and exported builds load the optimised extension:
; the rules run 30 Hz prediction and replays, and a debug build of them is
; far slower than the game. Build it with: cargo build --release -p realm_client
;
; Exports: Godot (4.7.2) copies the matching library from ../target/release
; (outside res:// is fine) beside the executable - macOS: into the bundle's
; Contents/Frameworks - and the exported game loads it from there. So build
; the release library there before exporting (for another platform's export,
; put that platform's library there: the three names differ), or hand
; tools/release/stage_client.sh the library to ship as its 4th argument.
[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]
windows.x86_64 = "res://../target/release/realm_client.dll"
linux.x86_64 = "res://../target/release/librealm_client.so"
macos = "res://../target/release/librealm_client.dylib"
