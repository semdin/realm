# /etc/realm/realm.env (root:realm, 0640). install.sh writes it with
# generated secrets; never commit a filled-in copy.
REALM_DATABASE_URL=postgres://realm:CHANGE_ME@127.0.0.1:5432/realm
# The coordinator's admin surface and the login service's calls to it.
REALM_SERVICE_TOKEN=CHANGE_ME
# Where players reach the map servers (their QUIC ports, UDP).
REALM_PUBLIC_HOST=203.0.113.10
# Game admins: account ids, comma separated. Read when the coordinator starts;
# nothing in the game can change it. Find an id with
#   SELECT account_id FROM characters WHERE name_key = lower('Character Name');
# REALM_GA_ACCOUNTS=
# New accounts per hour across the realm (0 closes registration during an attack).
# REALM_SIGNUPS_PER_HOUR=120
# Players in the whole realm, and per map (map=count; other maps keep the
# capacity in maps.json). Past these, logins wait in a first-come line.
# REALM_CAP=300
# REALM_MAP_CAPS=grounds=150
# Shouts: seconds between two from one account, and the level they start at.
# REALM_SHOUT_COOLDOWN_S=30
# REALM_SHOUT_MIN_LEVEL=5
# Extra words for the name and chat filter (realm_filter's format), kept here
# on the host rather than in the repository.
# REALM_FILTER_EXTRA=/etc/realm/words.txt
