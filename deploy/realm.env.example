# /etc/realm/realm.env (root:realm, 0640). install.sh writes it with
# generated secrets; never commit a filled-in copy.
REALM_DATABASE_URL=postgres://realm:CHANGE_ME@127.0.0.1:5432/realm
# The coordinator's admin surface and the login service's calls to it.
REALM_SERVICE_TOKEN=CHANGE_ME
# Where players reach the map servers (their QUIC ports, UDP).
REALM_PUBLIC_HOST=203.0.113.10
# Game admins at start (names, comma separated); the list is kept in the DB.
# REALM_GA=
